# ============================================================================
# PYTHON
# ============================================================================

# Bytecode compilado y optimizado
__pycache__/
*.py[cod]
*$py.class

# Distribuciones
*.egg-info/
dist/
build/

# Entornos virtuales
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store


# ============================================================================
# PROYECTO RAG - ARCHIVOS GENERADOS (NO VERSIONEAR)
# ============================================================================

# Base de datos vectorial (generada por indexar.py)
chroma_db/

# Métricas y evaluaciones (generadas por evaluar.py)
metrics/
*.jsonl
evaluations.jsonl
stats.json

# Documentos temporales o de prueba
docs/*.tmp
docs/*.bak
docs/*_old.*


# ============================================================================
# VARIABLES DE ENTORNO Y SECRETOS
# ============================================================================

.env
.env.local
.env.*.local
secrets/
*.key
*.pem


# ============================================================================
# ARCHIVOS DEL SISTEMA
# ============================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


