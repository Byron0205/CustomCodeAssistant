# ============================================================
# RAG Project — Configuración de proveedores
# Copiar este archivo a .env y editar los valores
# ============================================================

# --- Proveedor de LLM ---
# Opciones: ollama | claude | openai
LLM_PROVIDER=ollama

# --- Proveedor de embeddings ---
# Opciones: ollama | openai
# Nota: Claude no tiene API de embeddings propia.
# Si LLM_PROVIDER=claude, usar EMBED_PROVIDER=ollama o openai.
EMBED_PROVIDER=ollama

# --- Overrides de modelo (opcional) ---
# Si no se define, se usa el default del proveedor:
#   ollama → mistral:7b / nomic-embed-text
#   claude → claude-sonnet-4-6
#   openai → gpt-4o-mini / text-embedding-3-small
# LLM_MODEL=mistral:7b
# EMBED_MODEL=nomic-embed-text

# --- Ollama (solo si LLM_PROVIDER=ollama o EMBED_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic Claude (solo si LLM_PROVIDER=claude) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (solo si LLM_PROVIDER=openai o EMBED_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
